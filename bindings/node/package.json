{
  "name": "@rixmerz/kernodb",
  "version": "1.0.0-alpha.4",
  "description": "Kerno, an embedded database of units, revisions and relations, for Node.js",
  "keywords": ["database", "embedded", "memory", "ai", "napi-rs"],
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rixmerz/kernodb.git",
    "directory": "bindings/node"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "files": ["index.js", "binding.js", "index.d.ts", "LICENSE-MIT", "LICENSE-APACHE"],
  "publishConfig": { "access": "public" },
  "engines": { "node": ">= 20" },
  "packageManager": "pnpm@10.15.1",
  "napi": {
    "binaryName": "kernodb",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release --js binding.js",
    "build:debug": "napi build --platform --js binding.js",
    "test": "tsc --noEmit && node --test \"__test__/*.test.mts\"",
    "artifacts": "napi artifacts",
    "prepublishOnly": "napi prepublish -t npm --no-gh-release"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
